{
  "name": "shenscope",
  "displayName": "ShenScope",
  "description": "Julia coding agent with shared sessions, tools, permissions and model configuration.",
  "version": "0.1.0",
  "publisher": "SurviveAIEra",
  "license": "SEE LICENSE IN LICENSE",
  "repository": { "type": "git", "url": "https://github.com/SurviveAIEra/ShenScope.git" },
  "engines": { "vscode": "^1.95.0" },
  "categories": ["AI", "Programming Languages"],
  "main": "./dist/extension.js",
  "activationEvents": ["onView:shenscope.chat"],
  "capabilities": { "untrustedWorkspaces": { "supported": false }, "virtualWorkspaces": { "supported": false } },
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "shenscope", "title": "ShenScope", "icon": "media/icon.svg" }] },
    "views": { "shenscope": [{ "id": "shenscope.chat", "name": "ShenScope", "type": "webview" }] },
    "commands": [{ "command": "shenscope.restart", "title": "ShenScope: Restart Core" }],
    "configuration": { "title": "ShenScope launcher", "properties": {
      "shenscope.juliaPath": { "type": "string", "default": "julia", "description": "Julia 1.11 or later executable." },
      "shenscope.corePath": { "type": "string", "default": "", "description": "Core project directory; empty uses the packaged source." },
      "shenscope.statePath": { "type": "string", "default": "", "description": "Session storage directory; empty uses extension global storage." }
    } }
  }
}
